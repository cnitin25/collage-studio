{
  "name": "collage-studio",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "Offline-first photo collage editor — everything stays on your device",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json && tsc -p e2e",
    "test:e2e": "npm test --prefix e2e",
    "test:prod": "npm run test:prod --prefix e2e"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/great-vibes": "^5.2.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pacifico": "^5.2.7",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-konva": "^18.2.10",
    "use-image": "^1.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
